# ─── Extension build output ─────────────────────────────────────────────────
# Release zips are built by CI from the tagged manifest version.
# Building one locally is fine for manual testing but should never be committed.
*.zip

# ─── Node / npm ──────────────────────────────────────────────────────────────
# Installed packages — restored from package-lock.json via `npm install`.
node_modules/

# ─── Test harness — runtime artifacts ────────────────────────────────────────
# test-local/ is intentionally separate from test/ (source) so this single
# entry covers everything that must stay off GitHub:
#   .edge-profile/   — persistent Edge profile holding ServiceNow auth cookies
#   output/          — screenshots and JSON dumps from explore.js diagnostic runs
#   playwright-report/ — HTML report generated by `npm run test:assert`
#   test-results/    — Playwright traces and videos (written on failure)
test-local/

# ─── Editor and OS ───────────────────────────────────────────────────────────
# macOS metadata files created automatically by Finder.
.DS_Store
# VS Code workspace settings are personal to each developer's environment.
.vscode/settings.json

# ─── Local working directories (not part of the extension) ───────────────────
# Claude Code conversation and memory files generated during AI-assisted work.
.claude/
# Obsidian vault metadata for any notes kept alongside the project.
.obsidian/
# Local docs/ folder used for personal reference notes — not published content.
docs/
